# ===== QuantBot 开源仓库 .gitignore =====
#
# 封装策略（M4，已更新）：
#   - 决策脑（internal/brain + dll）现已【全量开源】，源码入库
#   - 构建产物 / 运行数据 / 数据库 / 密钥【永不入库】（即使宿主侧也排除）
#
# 注意：agent.dll 二进制产物不入库（bin/），仅以 Release 资产形式对外分发；
#       其源码（internal/brain + dll）已在仓库中开源，可按需自行编译。

# ---------------------------------------------------------------
# 一、构建产物（DLL/EXE 等二进制，永不公开）
# ---------------------------------------------------------------
/bin/

# ---------------------------------------------------------------
# 二、构建产物 / 依赖 / 运行数据（宿主侧也不入库）
# ---------------------------------------------------------------
# Wails 前端构建与 Go 运行产物
/build/
/dist/
*.exe
*.dll
*.h
node_modules/

# 真实行情 / 私有数据目录
/data/
/databak/
/qprobe/

# 数据库文件（含 python 行情库与探针库）——避免真实数据流出
**/*.duckdb
**/*.duckdb.wal
**/*.db
**/*.db-wal
**/*.db-shm

# 本地探针 / 临时 JSON / 日志 / 配置（可能含密钥）
/probe_stock2.duckdb
/t1.json
/t2.json
/tencent_k.json
/tencent_test.txt
*.log

# 密钥与本地环境
.env
.env.local
*.env

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# 本地编辑器 / 工具状态（个人开发环境，不入公开仓库）
/.trae/
/.workbuddy/

# 前端构建残留：正式构建走 /ui/，此目录为历史/生成的编译产物
/frontend/

# Python 缓存
__pycache__/
*.pyc