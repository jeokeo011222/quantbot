# ===== QuantBot 开源仓库 .gitignore =====
#
# 封装策略（M4）：
#   - 决策脑源码与构建产物【闭源】：/internal/brain/、/dll/、/bin/
#   - 其余宿主侧代码（App.go / internal/ / cmd/ / ui/ / python/ 等）【开源】
#   - 构建产物 / 运行数据 / 数据库 / 密钥【永不入库】（即使宿主侧也排除）
#
# 注意：DLL 侧二进制 internal/brain 仅以 bin/agent.dll(+agent.h) 形式对外分发，
#       其源码与构建脚本不入库。

# ---------------------------------------------------------------
# 一、闭源黑名单（决策脑 + DLL，永不公开）
# ---------------------------------------------------------------
/internal/brain/
/dll/
/bin/

# ---------------------------------------------------------------
# 二、构建产物 / 依赖 / 运行数据（宿主侧也不入库）
# ---------------------------------------------------------------
# Wails 前端构建与 Go 运行产物
/build/
/dist/
*.exe
*.dll
*.h
node_modules/

# 真实行情 / 私有数据目录
/data/
/databak/
/qprobe/

# 数据库文件（含 python 行情库与探针库）——避免真实数据流出
**/*.duckdb
**/*.duckdb.wal
**/*.db
**/*.db-wal
**/*.db-shm

# 本地探针 / 临时 JSON / 日志 / 配置（可能含密钥）
/probe_stock2.duckdb
/t1.json
/t2.json
/tencent_k.json
/tencent_test.txt
*.log

# 密钥与本地环境
.env
.env.local
*.env

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# 本地编辑器 / 工具状态（个人开发环境，不入公开仓库）
/.trae/
/.workbuddy/

# 前端构建残留：正式构建走 /ui/，此目录为历史/生成的编译产物
/frontend/

# Python 缓存
__pycache__/
*.pyc